      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 4 4\"/></svg><input type=\"search\" placeholder=\"Car, driver, team\" aria-label=\"Search car, driver or team\"></label>",
